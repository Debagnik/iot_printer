<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login - Print Queue Manager</title>
  <link rel="stylesheet" href="/style.css">
  <script>
    // Theme toggle logic
    function toggleTheme() {
      const current = localStorage.getItem('theme') || 'light';
      const next = current === 'light' ? 'dark' : 'light';
      document.documentElement.setAttribute('data-theme', next);
      localStorage.setItem('theme', next);
    }

    // Init theme
    const savedTheme = localStorage.getItem('theme') || 'light';
    document.documentElement.setAttribute('data-theme', savedTheme);
  </script>
</head>

<body>
  <div class="login-container">
    <div style="text-align: right; margin-bottom: 20px;">
      <button class="theme-toggle" onclick="toggleTheme()"
        style="background:var(--text-color); color:var(--bg-color)">Theme</button>
    </div>
    <h1>Print Queue Manager</h1>

    <% if (error) { %>
      <div class="alert alert-error">
        <%= error %>
      </div>
      <% } %>

        <% if (typeof success !=='undefined' && success) { %>
          <div class="success-message">
            <%= success %>
          </div>
          <% } %>

            <form method="POST" action="/login">
              <div class="form-group">
                <label for="username">Username</label>
                <input type="text" id="username" name="username" required autofocus>
              </div>

              <div class="form-group">
                <label for="password">Password</label>
                <input type="password" id="password" name="password" required>
              </div>

              <button type="submit">Login</button>
            </form>

            <% // Only show registration link if we didn't receive an error saying it's disabled // ACTUALLY, the
              requirement
              is "if the registration id set to off by admin then on the login page there should be no link to registration as well"
              // We can pass a variable to login view or check via AJAX, but passing variable is cleaner. // However,
              authController.getLogin doesn't pass 'registrationEnabled' . // Implementation Plan
              Step: "login.ejs: specific conditional" . // I need to update authController to pass this var, OR just
              handle the error. // Let's assume for now we rely on the error message or I will update authController
              quickly next. %>
              <!-- We will need to update authController to pass 'registrationEnabled' to hide this link fully -->
              <% if (typeof registrationEnabled==='undefined' || registrationEnabled) { %>
                <div class="register-link" style="text-align: center; margin-top: 20px;">
                  Don't have an account? <a href="/register">Create one here</a>
                </div>
                <% } %>
  </div>
</body>

</html>