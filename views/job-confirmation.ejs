<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Job Confirmation - Print Queue Manager</title>
  <link rel="stylesheet" href="/style.css">
  <script>
    function toggleTheme() {
      const current = localStorage.getItem('theme') || 'light';
      const next = current === 'light' ? 'dark' : 'light';
      document.documentElement.setAttribute('data-theme', next);
      localStorage.setItem('theme', next);
    }
    const savedTheme = localStorage.getItem('theme') || 'light';
    document.documentElement.setAttribute('data-theme', savedTheme);
  </script>
</head>
<body>
  <header>
    <div class="header-content">
      <h1>Print Queue Manager</h1>
      <div class="user-info">
        <button class="theme-toggle" onclick="toggleTheme()">Theme</button>
        <span>Job Confirmation</span>
        <a href="/logout" class="logout-btn">Logout</a>
      </div>
    </div>
  </header>

  <div class="container-md">
    <div class="confirmation-card" style="text-align: center;">
      <div class="success-icon">✓</div>
      <h2>Print Job Submitted</h2>
      <p style="color: var(--text-secondary); margin-bottom: 30px; font-size: 16px;">Your document has been successfully submitted to the print queue.</p>

      <div class="job-id-box">
        <div class="job-id-label">Job ID</div>
        <div class="job-id"><%= jobId %></div>
      </div>

      <% if (!submissionResult.success) { %>
        <div class="alert alert-warning">
          <strong>Note:</strong> <%= submissionResult.message %>
        </div>
      <% } else { %>
        <div class="alert alert-info">
          Your print job is now in the queue and will be processed by the printer.
        </div>
      <% } %>

      <div class="details-section">
        <h3>Job Details</h3>
        <div class="detail-row">
          <span class="detail-label">Document:</span>
          <span class="detail-value"><%= documentName %></span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Paper Type:</span>
          <span class="detail-value"><%= settings.paperType %></span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Print Quality:</span>
          <span class="detail-value"><%= settings.printQuality %> DPI</span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Color Mode:</span>
          <span class="detail-value"><%= settings.colorMode %></span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Paper Size:</span>
          <span class="detail-value"><%= settings.paperSize %></span>
        </div>
      </div>

      <div class="button-group">
        <a href="/dashboard" class="btn-primary">Back to Dashboard</a>
        <a href="/upload" class="btn-secondary">Submit Another Job</a>
      </div>
    </div>
  </div>
</body>
</html>
