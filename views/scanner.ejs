<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Scanner - Print Queue Manager</title>
  <link rel="stylesheet" href="/style.css">
  <script src="/theme.js"></script>
</head>

<body>
  <header>
    <div class="header-content">
      <h1>Print Queue Manager</h1>
      <div class="user-info">
        <button class="theme-toggle" onclick="toggleTheme()">Theme</button>
        <span>Welcome, <%= username %></span>
        <a href="/logout" class="logout-btn">Logout</a>
      </div>
    </div>
  </header>

  <div class="container">
    <div class="scanner-card">
      <h2>Document Scanner</h2>

      <% if (error) { %>
        <div class="alert alert-error">
          <%= error %>
        </div>
        <% } %>

          <% if (success) { %>
            <div class="alert alert-success">
              <%= success %>
            </div>
            <% } %>

              <form method="POST" action="/scanner" id="scanForm">
                <div class="form-group">
                  <label for="format">Output Format</label>
                  <select id="format" name="format" required>
                    <option value="pdf">PDF</option>
                    <option value="png">PNG</option>
                  </select>
                </div>

                <button type="submit" id="scanBtn">Scan Document</button>
              </form>

              <div class="scanning-indicator" id="scanningIndicator">
                <div class="spinner"></div>
                <p>Scanning document... Please wait</p>
              </div>
    </div>

    <div class="scanned-documents">
      <h3>Scanned Documents</h3>
      <div class="card">
        <table>
          <thead>
            <tr>
              <th>File Name</th>
              <th>Scanned</th>
              <th>Expires</th>
              <th>Size</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (scannedDocuments && scannedDocuments.length> 0) { %>
              <% scannedDocuments.forEach(doc=> { %>
                <tr>
                  <td>
                    <%= doc.fileName %>
                  </td>
                  <td>
                    <%= new Date(doc.createdAt).toLocaleString() %>
                  </td>
                  <td>
                    <%= new Date(doc.expiresAt).toLocaleString() %>
                  </td>
                  <td>
                    <%= (doc.size / 1024).toFixed(2) %> KB
                  </td>
                  <td>
                    <a href="/scanner/download/<%= doc.fileName %>" class="action-btn"
                      style="padding:4px 8px; font-size:12px; display:inline-block; text-decoration:none; text-align:center;">Download</a>
                    <button type="button" class="action-btn"
                      style="padding:4px 8px; font-size:12px; display:inline-block; background:var(--error-bg); color:var(--error-text);"
                      onclick="deleteDocument('<%= doc.fileName %>')">Delete</button>
                  </td>
                </tr>
                <% }); %>
                  <% } else { %>
                    <tr>
                      <td colspan="5" style="text-align:center;">No scanned documents yet. Scan a document to get
                        started.</td>
                    </tr>
                    <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <a href="/dashboard" class="back-link">← Back to Dashboard</a>
  </div>

  <script>
    let isScanning = false;

    // Handle form submission
    document.getElementById('scanForm').addEventListener('submit', function (e) {
      if (isScanning) {
        e.preventDefault();
        return;
      }

      // Allow form to submit naturally
      // e.preventDefault(); // REMOVED

      const scanBtn = document.getElementById('scanBtn');
      const scanningIndicator = document.getElementById('scanningIndicator');

      isScanning = true;
      scanBtn.disabled = true;
      scanningIndicator.classList.add('active');
    });

    // Delete document function
    function deleteDocument(fileName) {
      if (confirm('Are you sure you want to delete this document?')) {
        fetch(`/scanner/delete/${fileName}`, {
          method: 'DELETE'
        })
          .then(response => response.json())
          .then(data => {
            if (data.success) {
              location.reload();
            } else {
              alert('Error: ' + data.error);
            }
          })
          .catch(err => {
            console.error('Error:', err);
            alert('Failed to delete document');
          });
      }
    }
  </script>
</body>

</html>