<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Scanner - Print Queue Manager</title>
  <link rel="stylesheet" href="/style.css">
  <script>
    function toggleTheme() {
      const current = localStorage.getItem('theme') || 'light';
      const next = current === 'light' ? 'dark' : 'light';
      document.documentElement.setAttribute('data-theme', next);
      localStorage.setItem('theme', next);
    }
    const savedTheme = localStorage.getItem('theme') || 'light';
    document.documentElement.setAttribute('data-theme', savedTheme);
  </script>
</head>

<body>
  <header>
    <div class="header-content">
      <h1>Print Queue Manager</h1>
      <div class="user-info">
        <button class="theme-toggle" onclick="toggleTheme()"
          style="background:none; border:1px solid currentColor; padding: 4px 10px;">Theme</button>
        <span>Welcome, <%= username %></span>
        <a href="/logout" class="logout-btn">Logout</a>
      </div>
    </div>
  </header>

  <div class="container">
    <div class="scanner-card">
      <h2>Document Scanner</h2>

      <% if (error) { %>
        <div class="alert alert-error">
          <%= error %>
        </div>
        <% } %>

          <% if (success) { %>
            <div class="alert alert-success">
              <%= success %>
            </div>
            <% } %>

              <form method="POST" action="/scanner" id="scanForm">
                <div class="form-group">
                  <label for="format">Output Format</label>
                  <select id="format" name="format" required>
                    <option value="pdf">PDF</option>
                    <option value="png">PNG</option>
                  </select>
                </div>

                <button type="submit" id="scanBtn">Scan Document</button>
              </form>

              <div class="scanning-indicator" id="scanningIndicator">
                <div class="spinner"></div>
                <p>Scanning document... Please wait</p>
              </div>
    </div>

    <div class="scanned-documents">
      <h3>Scanned Documents</h3>
      <% if (scannedDocuments && scannedDocuments.length> 0) { %>
        <div class="documents-list">
          <% scannedDocuments.forEach(doc=> { %>
            <div class="document-item">
              <div class="document-info">
                <div class="document-name">
                  <%= doc.fileName %>
                </div>
                <div class="document-meta">
                  Scanned: <%= new Date(doc.createdAt).toLocaleString() %> |
                    Expires: <%= new Date(doc.expiresAt).toLocaleString() %> |
                      Size: <%= (doc.size / 1024).toFixed(2) %> KB
                </div>
              </div>
              <div class="document-actions">
                <a href="/scanner/download/<%= doc.fileName %>" class="btn-small btn-download">Download</a>
                <button type="button" class="btn-small btn-delete"
                  onclick="deleteDocument('<%= doc.fileName %>')">Delete</button>
              </div>
            </div>
            <% }); %>
        </div>
        <% } else { %>
          <div class="no-documents">
            <p>No scanned documents yet. Scan a document to get started.</p>
          </div>
          <% } %>
    </div>

    <a href="/dashboard" class="back-link">← Back to Dashboard</a>
  </div>

  <script>
    let isScanning = false;

    // Handle form submission
    document.getElementById('scanForm').addEventListener('submit', function (e) {
      if (isScanning) {
        e.preventDefault();
        return;
      }

      e.preventDefault();
      const scanBtn = document.getElementById('scanBtn');
      const scanningIndicator = document.getElementById('scanningIndicator');
      const format = document.getElementById('format').value;

      isScanning = true;
      scanBtn.disabled = true;
      scanningIndicator.classList.add('active');

      // Submit via fetch to prevent form state issues
      fetch('/scanner', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/x-www-form-urlencoded'
        },
        body: 'format=' + encodeURIComponent(format)
      })
        .then(response => response.text())
        .then(html => {
          document.open();
          document.write(html);
          document.close();
        })
        .catch(err => {
          console.error('Scan error:', err);
          isScanning = false;
          scanBtn.disabled = false;
          scanningIndicator.classList.remove('active');
          alert('Failed to scan document');
        });
    });

    // Delete document function
    function deleteDocument(fileName) {
      if (confirm('Are you sure you want to delete this document?')) {
        fetch(`/scanner/delete/${fileName}`, {
          method: 'DELETE'
        })
          .then(response => response.json())
          .then(data => {
            if (data.success) {
              location.reload();
            } else {
              alert('Error: ' + data.error);
            }
          })
          .catch(err => {
            console.error('Error:', err);
            alert('Failed to delete document');
          });
      }
    }
  </script>
</body>

</html>