<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Print Configuration - Print Queue Manager</title>
  <link rel="stylesheet" href="/style.css">
  <script>
    function toggleTheme() {
      const current = localStorage.getItem('theme') || 'light';
      const next = current === 'light' ? 'dark' : 'light';
      document.documentElement.setAttribute('data-theme', next);
      localStorage.setItem('theme', next);
    }
    const savedTheme = localStorage.getItem('theme') || 'light';
    document.documentElement.setAttribute('data-theme', savedTheme);
  </script>
</head>
<body>
  <header>
    <div class="header-content">
      <h1>Print Queue Manager</h1>
      <div class="user-info">
        <button class="theme-toggle" onclick="toggleTheme()">Theme</button>
        <span>Print Configuration</span>
        <a href="/logout" class="logout-btn">Logout</a>
      </div>
    </div>
  </header>

  <div class="container-md">
    <div class="config-card">
      <h2>Configure Print Settings</h2>

      <% if (error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>

      <% if (success) { %>
        <div class="alert alert-success"><%= success %></div>
        <div style="margin-top: 20px; text-align: center;">
          <a href="/submit-job" class="btn-primary">Proceed to Submit Job</a>
        </div>
      <% } %>

      <% if (!success) { %>
      <form method="POST" action="/configure">
        <div class="form-row">
          <div class="form-group">
            <label for="paperType">Paper Type</label>
            <select id="paperType" name="paperType" required>
              <% options.paperTypes.forEach(type => { %>
                <option value="<%= type %>" <%= defaults.paperType === type ? 'selected' : '' %>>
                  <%= type %>
                </option>
              <% }); %>
            </select>
          </div>

          <div class="form-group">
            <label for="printQuality">Print Quality</label>
            <select id="printQuality" name="printQuality" required>
              <% options.printQualities.forEach(quality => { %>
                <option value="<%= quality %>" <%= defaults.printQuality === quality ? 'selected' : '' %>>
                  <%= quality %>
                </option>
              <% }); %>
            </select>
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="colorMode">Color Mode</label>
            <select id="colorMode" name="colorMode" required>
              <% options.colorModes.forEach(mode => { %>
                <option value="<%= mode %>" <%= defaults.colorMode === mode ? 'selected' : '' %>>
                  <%= mode %>
                </option>
              <% }); %>
            </select>
          </div>

          <div class="form-group">
            <label for="paperSize">Paper Size</label>
            <select id="paperSize" name="paperSize" required>
              <% options.paperSizes.forEach(size => { %>
                <option value="<%= size %>" <%= defaults.paperSize === size ? 'selected' : '' %>>
                  <%= size %>
                </option>
              <% }); %>
            </select>
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="numCopies">Number of Copies</label>
            <input type="number" id="numCopies" name="numCopies" min="1" max="99" value="<%= defaults.numCopies || 1 %>" required>
          </div>

          <div class="form-group">
            <label for="doubleSided">Double-Sided Printing</label>
            <div class="toggle-container">
              <span class="toggle-switch">
                <input type="checkbox" id="doubleSided" name="doubleSided" <%= defaults.doubleSided ? 'checked' : '' %>>
                <span class="toggle-slider"></span>
              </span>
              <span class="toggle-label" id="doubleSidedLabel">Off</span>
            </div>
          </div>
        </div>

        <% if (pageCount) { %>
        <div class="paper-estimate" id="paperEstimate">
          <div class="estimate-icon">📄</div>
          <div class="estimate-details">
            <div class="estimate-label">Paper Sheets Needed</div>
            <div class="estimate-value" id="sheetsNeeded">--</div>
            <div class="estimate-breakdown" id="sheetsBreakdown"></div>
          </div>
        </div>
        <% } %>

        <div class="button-group">
          <button type="submit" class="btn-primary">Save Settings</button>
          <a href="/dashboard" class="btn-secondary">Back to Dashboard</a>
        </div>
      </form>
      <% } %>

      <div class="defaults-info">
        <strong>Default Settings:</strong><br>
        Paper Type: <%= defaults.paperType %><br>
        Print Quality: <%= defaults.printQuality %><br>
        Color Mode: <%= defaults.colorMode %><br>
        Paper Size: <%= defaults.paperSize %><br>
        Double-Sided: <%= defaults.doubleSided ? 'Yes' : 'No' %><br>
        Copies: <%= defaults.numCopies || 1 %>
      </div>
    </div>
  </div>

  <script>
    (function () {
      var pageCount = <%= pageCount || 'null' %>;
      var doubleSidedEl = document.getElementById('doubleSided');
      var numCopiesEl = document.getElementById('numCopies');
      var labelEl = document.getElementById('doubleSidedLabel');
      var sheetsEl = document.getElementById('sheetsNeeded');
      var breakdownEl = document.getElementById('sheetsBreakdown');

      function updateLabel() {
        if (labelEl) {
          labelEl.textContent = doubleSidedEl.checked ? 'On' : 'Off';
        }
      }

      function updateEstimate() {
        if (!pageCount || !sheetsEl) return;
        var copies = parseInt(numCopiesEl.value, 10) || 1;
        var sheets;
        var breakdown;
        if (doubleSidedEl.checked) {
          sheets = Math.ceil(pageCount / 2) * copies + 1;
          breakdown = Math.ceil(pageCount / 2) + ' sheets/copy × ' + copies + ' copies + 1 buffer = ' + sheets + ' sheets';
        } else {
          sheets = (copies * pageCount) + 1;
          breakdown = pageCount + ' pages × ' + copies + ' copies + 1 buffer = ' + sheets + ' sheets';
        }
        sheetsEl.textContent = sheets;
        breakdownEl.textContent = breakdown;
      }

      if (doubleSidedEl) {
        doubleSidedEl.addEventListener('change', function () { updateLabel(); updateEstimate(); });
      }
      if (numCopiesEl) {
        numCopiesEl.addEventListener('input', updateEstimate);
      }

      updateLabel();
      updateEstimate();
    })();
  </script>
</body>
</html>
