<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dashboard - Print Queue Manager</title>
  <link rel="stylesheet" href="/style.css">
  <script>
    function toggleTheme() {
      const current = localStorage.getItem('theme') || 'light';
      const next = current === 'light' ? 'dark' : 'light';
      document.documentElement.setAttribute('data-theme', next);
      localStorage.setItem('theme', next);
    }
    const savedTheme = localStorage.getItem('theme') || 'light';
    document.documentElement.setAttribute('data-theme', savedTheme);
  </script>
</head>

<body>
  <header>
    <div class="header-content">
      <h1>Admin Dashboard</h1>
      <div class="user-info">
        <button class="theme-toggle" onclick="toggleTheme()"
          style="background:none; border:1px solid currentColor; padding: 4px 10px;">Theme</button>
        <span>Welcome, <%= username %> (Admin)</span>
        <a href="/logout" class="logout-btn">Logout</a>
      </div>
    </div>
  </header>

  <div class="container">
    <% if (error) { %>
      <div class="alert alert-error">
        <%= error %>
      </div>
      <% } %>

        <% if (success) { %>
          <div class="alert alert-success">
            <%= success %>
          </div>
          <% } %>

            <div class="tabs">
              <button class="tab-btn active" onclick="switchTab('users', event)">Users</button>
              <button class="tab-btn" onclick="switchTab('jobs', event)">Print Jobs</button>
              <button class="tab-btn" onclick="switchTab('scans', event)">Scan Jobs</button>
              <button class="tab-btn" onclick="switchTab('cleanup', event)">Cleanup</button>
            </div>

            <!-- Users Tab -->
            <div id="users" class="tab-content active">
              <h2>User Management</h2>

              <div class="card" style="margin-top: 20px;">
                <h3>Create New User</h3>
                <div class="form-row" style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                  <div class="form-group">
                    <label for="newUsername">Username</label>
                    <input type="text" id="newUsername" placeholder="Enter username">
                  </div>
                  <div class="form-group">
                    <label for="newPassword">Password</label>
                    <input type="password" id="newPassword" placeholder="Enter password">
                  </div>
                </div>
                <div class="form-group">
                  <label for="newRole">Role</label>
                  <select id="newRole">
                    <option value="USER">User</option>
                    <option value="ADMIN">Admin</option>
                  </select>
                </div>
                <button onclick="createNewUser()">Create User</button>
              </div>

              <div class="card" style="margin-top: 30px;">
                <h3>Registration Settings</h3>
                <div style="display: flex; align-items: center; gap: 15px; margin-top: 15px;">
                  <label style="margin: 0; cursor: pointer;">
                    <input type="checkbox" id="registrationToggle" onchange="toggleRegistration()" style="width: auto;">
                    Allow new user registration
                  </label>
                  <span id="registrationStatus" style="font-size: 12px; color: var(--text-color); opacity: 0.7;"></span>
                </div>
              </div>

              <h3 style="margin-top: 30px;">All Users</h3>
              <div class="card">
                <table>
                  <thead>
                    <tr>
                      <th>Username</th>
                      <th>Role</th>
                      <th>Status</th>
                      <th>Created</th>
                      <th>Actions</th>
                    </tr>
                  </thead>
                  <tbody id="usersTable">
                    <% users.forEach(user=> { %>
                      <tr>
                        <td>
                          <%= user.username %>
                        </td>
                        <td>
                          <%= user.role %>
                        </td>
                        <td>
                          <% if (user.enabled) { %>
                            <span class="status-badge status-enabled">Enabled</span>
                            <% } else { %>
                              <span class="status-badge status-disabled">Disabled</span>
                              <% } %>
                        </td>
                        <td>
                          <%= new Date(user.createdAt).toLocaleString() %>
                        </td>
                        <td>
                          <button class="action-btn" style="padding:4px 8px; font-size:12px; display:inline-block;"
                            data-user-id="<%= user.id %>" data-username="<%= user.username %>"
                            onclick="openResetPasswordModal(this.dataset.userId, this.dataset.username)">Reset
                            Pwd</button>
                          <button class="action-btn" style="padding:4px 8px; font-size:12px; display:inline-block;"
                            data-user-id="<%= user.id %>" data-username="<%= user.username %>"
                            data-role="<%= user.role %>"
                            onclick="openRoleModal(this.dataset.userId, this.dataset.username, this.dataset.role)">Role</button>
                          <% if (user.enabled) { %>
                            <button class="action-btn"
                              style="padding:4px 8px; font-size:12px; display:inline-block; background:var(--error-bg); color:var(--error-text);"
                              data-user-id="<%= user.id %>"
                              onclick="toggleUserStatus(this.dataset.userId, false)">Disable</button>
                            <% } else { %>
                              <button class="action-btn" style="padding:4px 8px; font-size:12px; display:inline-block;"
                                data-user-id="<%= user.id %>"
                                onclick="toggleUserStatus(this.dataset.userId, true)">Enable</button>
                              <% } %>
                                <% if (user.id !==userId) { %>
                                  <button class="action-btn"
                                    style="padding:4px 8px; font-size:12px; display:inline-block; background:var(--error-bg); color:var(--error-text);"
                                    data-user-id="<%= user.id %>" data-username="<%= user.username %>"
                                    onclick="deleteUser(this.dataset.userId, this.dataset.username)">Delete</button>
                                  <% } %>
                        </td>
                      </tr>
                      <% }); %>
                  </tbody>
                </table>
              </div>
            </div>

            <!-- Jobs Tab -->
            <div id="jobs" class="tab-content">
              <h2>Print Jobs Management</h2>

              <div class="card">
                <table>
                  <thead>
                    <tr>
                      <th>Job ID</th>
                      <th>User</th>
                      <th>Document</th>
                      <th>Status</th>
                      <th>Submitted</th>
                      <th>Actions</th>
                    </tr>
                  </thead>
                  <tbody id="jobsTable">
                    <% jobs.forEach(job=> { %>
                      <tr>
                        <td>
                          <%= job.id %>
                        </td>
                        <td>
                          <%= job.username %>
                        </td>
                        <td>
                          <%= job.documentName %>
                        </td>
                        <td><span class="status-badge status-<%= job.status %>">
                            <%= job.status %>
                          </span></td>
                        <td>
                          <%= new Date(job.submittedAt).toLocaleString() %>
                        </td>
                        <td>
                          <button class="action-btn"
                            style="padding:4px 8px; font-size:12px; background:var(--error-bg); color:var(--error-text);"
                            data-job-id="<%= job.id %>" onclick="deleteJob(this.dataset.jobId)">Delete</button>
                        </td>
                      </tr>
                      <% }); %>
                  </tbody>
                </table>
              </div>
            </div>

            <!-- Scans Tab -->
            <div id="scans" class="tab-content">
              <h2>Scan Jobs Management</h2>

              <div class="card">
                <table>
                  <thead>
                    <tr>
                      <th>Scan ID</th>
                      <th>File Name</th>
                      <th>Format</th>
                      <th>Created</th>
                      <th>Actions</th>
                    </tr>
                  </thead>
                  <tbody id="scansTable">
                    <% if (typeof scans !=='undefined' && scans.length> 0) { %>
                      <% scans.forEach(scan=> { %>
                        <tr>
                          <td>
                            <%= scan.id %>
                          </td>
                          <td>
                            <%= scan.fileName %>
                          </td>
                          <td>
                            <%= scan.fileName.split('.').pop().toUpperCase() %>
                          </td>
                          <td>
                            <%= new Date(scan.createdAt).toLocaleString() %>
                          </td>
                          <td>
                            <button class="action-btn"
                              style="padding:4px 8px; font-size:12px; background:var(--error-bg); color:var(--error-text);"
                              data-scan-id="<%= scan.id %>" onclick="deleteScan(this.dataset.scanId)">Delete</button>
                          </td>
                        </tr>
                        <% }); %>
                          <% } else { %>
                            <tr>
                              <td colspan="5" style="text-align:center;">No scan jobs found.</td>
                            </tr>
                            <% } %>
                  </tbody>
                </table>
              </div>
            </div>

            <!-- Cleanup Tab -->
            <div id="cleanup" class="tab-content">
              <h2>System Cleanup</h2>

              <div class="card">
                <p>Clean up local job files from uploads and scanned documents directories.</p>
                <button onclick="cleanupFiles()" style="margin-top: 20px;">Clean Up Files</button>
              </div>
            </div>

            <a href="/dashboard" class="back-link">← Back to Dashboard</a>
  </div>

  <!-- Reset Password Modal -->
  <div id="resetPasswordModal" class="modal">
    <div class="modal-content">
      <div class="modal-header" style="font-size:20px; font-weight:600; margin-bottom:20px;">Reset Password</div>
      <div class="form-group">
        <label for="resetPasswordInput">New Password</label>
        <input type="password" id="resetPasswordInput" placeholder="Enter new password">
      </div>
      <div class="modal-footer" style="display:flex; justify-content:flex-end; gap:10px; margin-top:20px;">
        <button onclick="closeModal('resetPasswordModal')" style="background:grey;">Cancel</button>
        <button onclick="submitResetPassword()">Reset</button>
      </div>
    </div>
  </div>

  <!-- Change Role Modal -->
  <div id="roleModal" class="modal">
    <div class="modal-content">
      <div class="modal-header" style="font-size:20px; font-weight:600; margin-bottom:20px;">Change User Role</div>
      <div class="form-group">
        <label for="roleSelect">Role</label>
        <select id="roleSelect">
          <option value="USER">User</option>
          <option value="ADMIN">Admin</option>
        </select>
      </div>
      <div class="modal-footer" style="display:flex; justify-content:flex-end; gap:10px; margin-top:20px;">
        <button onclick="closeModal('roleModal')" style="background:grey;">Cancel</button>
        <button onclick="submitRoleChange()">Update</button>
      </div>
    </div>
  </div>

  <script>
    let currentUserId = null;
    let currentUsername = null;

    function switchTab(tabName, event) {
      document.querySelectorAll('.tab-content').forEach(tab => tab.classList.remove('active'));
      document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));

      document.getElementById(tabName).classList.add('active');
      if (event) event.target.classList.add('active');
    }

    function loadRegistrationStatus() {
      fetch('/api/admin/registration')
        .then(res => res.json())
        .then(data => {
          if (data.success) {
            document.getElementById('registrationToggle').checked = data.registrationEnabled;
            document.getElementById('registrationStatus').textContent =
              data.registrationEnabled ? '(Currently enabled)' : '(Currently disabled)';
          }
        })
        .catch(err => console.error('Error loading registration status:', err));
    }

    function toggleRegistration() {
      const enabled = document.getElementById('registrationToggle').checked;

      fetch('/api/admin/registration', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ enabled })
      })
        .then(res => res.json())
        .then(data => {
          if (data.success) {
            document.getElementById('registrationStatus').textContent =
              enabled ? '(Currently enabled)' : '(Currently disabled)';
            alert(data.message);
          } else {
            alert('Error: ' + data.error);
            document.getElementById('registrationToggle').checked = !enabled;
          }
        })
        .catch(err => {
          alert('Error: ' + err.message);
          document.getElementById('registrationToggle').checked = !enabled;
        });
    }

    function toggleUserStatus(userId, enabled) {
      const action = enabled ? 'enable' : 'disable';
      // Convert boolean string to boolean if coming from dataset might need parsing, but direct arg is safer
      // In onclick: toggleUserStatus(this.dataset.userId, false) passes false literal

      if (!confirm(`Are you sure you want to ${action} this user?`)) return;

      fetch(`/api/admin/users/${userId}/enabled`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ enabled })
      })
        .then(res => res.json())
        .then(data => {
          if (data.success) {
            alert(data.message);
            location.reload();
          } else {
            alert('Error: ' + data.error);
          }
        })
        .catch(err => alert('Error: ' + err.message));
    }

    function openResetPasswordModal(userId, username) {
      currentUserId = userId;
      currentUsername = username;
      document.getElementById('resetPasswordModal').classList.add('active');
    }

    function openRoleModal(userId, username, currentRole) {
      currentUserId = userId;
      currentUsername = username;
      document.getElementById('roleSelect').value = currentRole;
      document.getElementById('roleModal').classList.add('active');
    }

    function closeModal(modalId) {
      document.getElementById(modalId).classList.remove('active');
    }

    function submitResetPassword() {
      const newPassword = document.getElementById('resetPasswordInput').value;

      if (!newPassword || newPassword.length < 6) {
        alert('Password must be at least 6 characters');
        return;
      }

      fetch(`/api/admin/users/${currentUserId}/reset-password`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ newPassword })
      })
        .then(res => res.json())
        .then(data => {
          if (data.success) {
            alert('Password reset successfully');
            closeModal('resetPasswordModal');
            document.getElementById('resetPasswordInput').value = '';
          } else {
            alert('Error: ' + data.error);
          }
        })
        .catch(err => alert('Error: ' + err.message));
    }

    function submitRoleChange() {
      const role = document.getElementById('roleSelect').value;

      fetch(`/api/admin/users/${currentUserId}/role`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ role })
      })
        .then(res => res.json())
        .then(data => {
          if (data.success) {
            alert('Role updated successfully');
            closeModal('roleModal');
            location.reload();
          } else {
            alert('Error: ' + data.error);
          }
        })
        .catch(err => alert('Error: ' + err.message));
    }

    function createNewUser() {
      const username = document.getElementById('newUsername').value;
      const password = document.getElementById('newPassword').value;
      const role = document.getElementById('newRole').value;

      if (!username || !password) {
        alert('Username and password required');
        return;
      }

      fetch('/api/admin/users', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ username, password, role })
      })
        .then(res => res.json())
        .then(data => {
          if (data.success) {
            alert('User created successfully');
            document.getElementById('newUsername').value = '';
            document.getElementById('newPassword').value = '';
            location.reload();
          } else {
            alert('Error: ' + data.error);
          }
        })
        .catch(err => alert('Error: ' + err.message));
    }

    function deleteUser(userId, username) {
      if (!confirm(`Are you sure you want to delete user "${username}"?`)) return;

      fetch(`/api/admin/users/${userId}`, { method: 'DELETE' })
        .then(res => res.json())
        .then(data => {
          if (data.success) {
            alert('User deleted successfully');
            location.reload();
          } else {
            alert('Error: ' + data.error);
          }
        })
        .catch(err => alert('Error: ' + err.message));
    }

    function deleteJob(jobId) {
      if (!confirm('Are you sure you want to delete this job?')) return;

      fetch(`/api/admin/jobs/${jobId}`, { method: 'DELETE' })
        .then(res => res.json())
        .then(data => {
          if (data.success) {
            alert('Job deleted successfully');
            location.reload();
          } else {
            alert('Error: ' + data.error);
          }
        })
        .catch(err => alert('Error: ' + err.message));
    }

    function deleteScan(scanId) {
      if (!confirm('Are you sure you want to delete this scan job?')) return;

      fetch(`/api/admin/scans/${scanId}`, { method: 'DELETE' })
        .then(res => res.json())
        .then(data => {
          if (data.success) {
            alert('Scan job deleted successfully');
            location.reload();
          } else {
            alert('Error: ' + data.error);
          }
        })
        .catch(err => alert('Error: ' + err.message));
    }

    function cleanupFiles() {
      if (!confirm('This will delete all files in uploads and scanned documents directories. Continue?')) return;

      fetch('/api/admin/cleanup', { method: 'POST' })
        .then(res => res.json())
        .then(data => {
          if (data.success) {
            alert(data.message);
          } else {
            alert('Error: ' + data.error);
          }
        })
        .catch(err => alert('Error: ' + err.message));
    }

    // Close modal when clicking outside
    window.onclick = function (event) {
      const modals = document.querySelectorAll('.modal');
      modals.forEach(modal => {
        if (event.target === modal) {
          modal.classList.remove('active');
        }
      });
    }

    // Load registration status on page load
    document.addEventListener('DOMContentLoaded', loadRegistrationStatus);
  </script>
</body>

</html>