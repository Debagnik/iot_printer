<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard - Print Queue Manager</title>
  <link rel="stylesheet" href="/style.css">
  <script src="/theme.js"></script>
</head>

<body>
  <header>
    <div class="header-content">
      <h1>Print Queue Manager</h1>
      <div class="user-info">
        <button class="theme-toggle" onclick="toggleTheme()">Theme</button>
        <span>Welcome, <%= username %></span>
        <% if (typeof role !=='undefined' && role==='ADMIN' ) { %>
          <a href="/admin" style="color: white; text-decoration: none; margin-right: 10px; font-weight: bold;">Admin
            Panel</a>
          <% } %>
            <a href="/logout" class="logout-btn">Logout</a>
      </div>
    </div>
  </header>

  <div class="container">
    <div class="welcome-message card">
      <h2>Dashboard</h2>
      <p>Welcome to the Print Queue Manager.</p>
    </div>

    <div class="actions" style="margin-bottom: 30px;">
      <a href="/upload" class="action-btn"
        style="display:inline-block; padding:12px 24px; background:var(--primary-color); color:white; border-radius:4px; text-decoration:none;">Upload
        Document</a>
      <a href="/scanner" class="action-btn"
        style="display:inline-block; padding:12px 24px; background:var(--primary-color); color:white; border-radius:4px; text-decoration:none; margin-left: 10px;">Scan
        Document</a>
      <button type="button" class="action-btn" style="margin-left: 10px;" onclick="runCleanup()">Clean Up
        Storage</button>
    </div>

    <div class="job-history card">
      <h3>Print Job History</h3>
      <% if (jobs && jobs.length> 0) { %>
        <table class="jobs-table">
          <thead>
            <tr>
              <th>Job ID</th>
              <th>Document Name</th>
              <th>Submitted</th>
              <th>Status</th>
              <th>Paper Type</th>
              <th>Quality</th>
              <th>Color Mode</th>
              <th>Paper Size</th>
            </tr>
          </thead>
          <tbody>
            <% jobs.forEach(job=> { %>
              <tr class="job-row status-<%= job.status %>">
                <td>
                  <%= job.id %>
                </td>
                <td>
                  <%= job.documentName %>
                </td>
                <td>
                  <%= new Date(job.submittedAt).toLocaleString() %>
                </td>
                <td>
                  <span class="status-badge status-<%= job.status %>">
                    <%= job.status.charAt(0).toUpperCase() + job.status.slice(1) %>
                  </span>
                </td>
                <td>
                  <%= job.paperType %>
                </td>
                <td>
                  <%= job.printQuality %>
                </td>
                <td>
                  <%= job.colorMode %>
                </td>
                <td>
                  <%= job.paperSize %>
                </td>
              </tr>
              <% }); %>
          </tbody>
        </table>
        <% } else { %>
          <p class="no-jobs" style="text-align:center; padding:20px;">No print jobs yet. <a href="/upload">Upload a
              document</a> to get started.</p>
          <% } %>
    </div>
  </div>

  <script>
    // Auto-refresh job statuses every 5 seconds
    function updateJobStatuses() {
      const jobRows = document.querySelectorAll('.job-row');

      jobRows.forEach(row => {
        const jobId = row.querySelector('td').textContent;
        const statusCell = row.querySelector('.status-badge');

        // Only check jobs that are in-progress
        if (statusCell.classList.contains('status-in-progress')) {
          fetch(`/api/job/${jobId}/status`)
            .then(response => response.json())
            .then(data => {
              if (data.updated) {
                // Update the status badge
                statusCell.classList.remove('status-in-progress');
                statusCell.classList.add(`status-${data.status}`);
                statusCell.textContent = data.status.charAt(0).toUpperCase() + data.status.slice(1);

                // Update the row class
                row.classList.remove('status-in-progress');
                row.classList.add(`status-${data.status}`);
              }
            })
            .catch(err => console.error('Error updating job status:', err));
        }
      });
    }

    // Run manual cleanup
    function runCleanup() {
      if (confirm('This will delete all files older than 24 hours. Continue?')) {
        const btn = event.target;
        btn.disabled = true;
        btn.textContent = 'Cleaning...';

        fetch('/api/cleanup', {
          method: 'POST'
        })
          .then(response => response.json())
          .then(data => {
            alert(`Cleanup completed!\n\nDeleted:\n- ${data.details.uploadedDocs} uploaded documents\n- ${data.details.scannedDocs} scanned documents\n- ${data.details.printJobs} print jobs`);
            btn.disabled = false;
            btn.textContent = 'Clean Up Storage';
            location.reload();
          })
          .catch(err => {
            console.error('Error:', err);
            alert('Cleanup failed. Check console for details.');
            btn.disabled = false;
            btn.textContent = 'Clean Up Storage';
          });
      }
    }

    // Check job statuses on page load and then every 5 seconds
    updateJobStatuses();
    setInterval(updateJobStatuses, 5000);
  </script>
</body>

</html>