<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Flip Pages - Print Queue Manager</title>
    <link rel="stylesheet" href="/style.css">
    <script>
      function toggleTheme() {
        const current = localStorage.getItem('theme') || 'light';
        const next = current === 'light' ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', next);
        localStorage.setItem('theme', next);
      }
      const savedTheme = localStorage.getItem('theme') || 'light';
      document.documentElement.setAttribute('data-theme', savedTheme);
    </script>
</head>
<body>
    <header>
        <div class="header-content">
            <h1>Print Queue Manager</h1>
            <div class="user-info">
                <button class="theme-toggle" onclick="toggleTheme()">Theme</button>
                <span>Double-Sided Print</span>
                <a href="/logout" class="logout-btn">Logout</a>
            </div>
        </div>
    </header>

    <div class="container-md" style="max-width: 700px;">
        <div class="flip-card" style="text-align: center; padding: 40px 30px; border-radius: 12px;">
            <div class="step-badge">STEP 2 OF 2</div>
            <h2>Flip Your Pages</h2>
            <p style="color: var(--text-muted); font-size: 14px; margin-bottom: 30px;">The front side (odd pages) has been sent to the printer.</p>

            <div class="flip-animation">
                <div class="page-icon page-back">1</div>
                <div class="page-icon page-front">2</div>
                <div class="flip-arrow">↻</div>
            </div>

            <div class="alert alert-info" style="text-align: left; margin-bottom: 25px;">
                <strong>Important:</strong> Wait for the printer to finish printing the front side. Then remove the
                printed stack, flip it over, and place it back into the paper tray before continuing.
            </div>

            <div class="steps">
                <div class="step">
                    <div class="step-number">1</div>
                    <div class="step-text">Wait for the printer to finish printing all odd-numbered pages (front side).</div>
                </div>
                <div class="step">
                    <div class="step-number">2</div>
                    <div class="step-text">Remove the entire printed stack from the output tray.</div>
                </div>
                <div class="step">
                    <div class="step-number">3</div>
                    <div class="step-text">Flip the stack upside-down and place it back into the paper input tray.</div>
                </div>
                <div class="step">
                    <div class="step-number">4</div>
                    <div class="step-text">Click the button below to print the even-numbered pages (back side).</div>
                </div>
            </div>

            <div class="job-info">
                <div class="job-info-item">
                    <span class="job-info-label">Job ID</span>
                    <span class="job-info-value"><%= jobId %></span>
                </div>
                <div class="job-info-item">
                    <span class="job-info-label">Document</span>
                    <span class="job-info-value"><%= documentName %></span>
                </div>
                <div class="job-info-item">
                    <span class="job-info-label">Copies</span>
                    <span class="job-info-value"><%= numCopies %></span>
                </div>
            </div>

            <form method="POST" action="/submit-job/confirm-flip">
                <button type="submit" class="confirm-btn">
                    ✅ I've Flipped the Pages — Print Back Side
                </button>
            </form>
        </div>
    </div>
</body>
</html>