<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Submit Print Job - Print Queue Manager</title>
  <link rel="stylesheet" href="/style.css">
  <script>
    function toggleTheme() {
      const current = localStorage.getItem('theme') || 'light';
      const next = current === 'light' ? 'dark' : 'light';
      document.documentElement.setAttribute('data-theme', next);
      localStorage.setItem('theme', next);
    }
    const savedTheme = localStorage.getItem('theme') || 'light';
    document.documentElement.setAttribute('data-theme', savedTheme);
  </script>
</head>
<body>
  <header>
    <div class="header-content">
      <h1>Print Queue Manager</h1>
      <div class="user-info">
        <button class="theme-toggle" onclick="toggleTheme()">Theme</button>
        <span>Submit Print Job</span>
        <a href="/logout" class="logout-btn">Logout</a>
      </div>
    </div>
  </header>

  <div class="container-md">
    <div class="submit-card">
      <h2>Review and Submit Print Job</h2>

      <% if (error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>

      <% if (success) { %>
        <div class="alert alert-success"><%= success %></div>
      <% } %>

      <form method="POST" action="/submit-job">
        <div class="section">
          <h3>Document Information</h3>
          <div class="info-row">
            <span class="info-label">File Name:</span>
            <span class="info-value"><%= uploadedFile.originalName %></span>
          </div>
          <div class="info-row">
            <span class="info-label">File Size:</span>
            <span class="info-value"><%= (uploadedFile.size / 1024).toFixed(2) %> KB</span>
          </div>
          <div class="info-row">
            <span class="info-label">Uploaded:</span>
            <span class="info-value"><%= new Date(uploadedFile.uploadedAt).toLocaleString() %></span>
          </div>
        </div>

        <div class="section">
          <h3>Print Settings</h3>
          <div class="settings-grid">
            <div class="setting-item">
              <span class="setting-label">Paper Type</span>
              <span class="setting-value"><%= settings.paperType %></span>
            </div>
            <div class="setting-item">
              <span class="setting-label">Print Quality</span>
              <span class="setting-value"><%= settings.printQuality %></span>
            </div>
            <div class="setting-item">
              <span class="setting-label">Color Mode</span>
              <span class="setting-value"><%= settings.colorMode %></span>
            </div>
            <div class="setting-item">
              <span class="setting-label">Paper Size</span>
              <span class="setting-value"><%= settings.paperSize %></span>
            </div>
            <div class="setting-item">
              <span class="setting-label">Double-Sided</span>
              <span class="setting-value"><%= settings.doubleSided ? 'Yes' : 'No' %></span>
            </div>
            <div class="setting-item">
              <span class="setting-label">Copies</span>
              <span class="setting-value"><%= settings.numCopies || 1 %></span>
            </div>
            <% if (uploadedFile.pageCount) { var copies=settings.numCopies || 1; var
              pages=uploadedFile.pageCount; var sheets=settings.doubleSided ? Math.ceil(pages / 2) * copies + 1
              : (copies * pages) + 1; %>
              <div class="setting-item">
                <span class="setting-label">Pages</span>
                <span class="setting-value"><%= pages %></span>
              </div>
              <div class="setting-item">
                <span class="setting-label">Paper Sheets Needed</span>
                <span class="setting-value" style="color: var(--primary-color);"><%= sheets %></span>
              </div>
            <% } %>
          </div>
        </div>

        <div class="button-group">
          <button type="submit" class="btn-primary">Submit to Printer</button>
          <a href="/upload" class="btn-secondary">Cancel</a>
        </div>
      </form>
    </div>
  </div>
</body>
</html>